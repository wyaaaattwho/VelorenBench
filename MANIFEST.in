include LICENSE README.md NOTICE.md BENCHMARK_CARD.md API.md TASKS.md SUPPORT.md BUILD.md
include PROVENANCE.md TESTING.md CONTRIBUTING.md requirements-build.lock requirements-test.lock
include requirements-test-sdk.lock
include VISUALIZATION.md
recursive-include harness/scripts/rpg_benchmark *.html *.js
recursive-include config *.json
recursive-include tools *.py
recursive-include harness/scripts *.py *.json *.md
recursive-include harness/tests *.py *.json
include integrations/deepseek/.gitignore integrations/deepseek/LICENSE
include integrations/deepseek/MANIFEST.in integrations/deepseek/NOTICE.md
include integrations/deepseek/README.md integrations/deepseek/PROVENANCE.md
include integrations/deepseek/pyproject.toml integrations/deepseek/requirements*.lock
recursive-include integrations/deepseek/dsh_external_v1 *.py *.mjs *.json *.lock
recursive-include integrations/deepseek/tests *.py *.mjs
global-exclude __pycache__ *.py[cod]
prune verification
prune native-dist
prune build
prune dist
prune native
prune materials
prune outputs
prune integrations/deepseek/.work
prune integrations/deepseek/verification
prune integrations/deepseek/build
prune integrations/deepseek/dist
